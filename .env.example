# Copy this file to .env and fill in only the services you switch to 'live' in
# src/config/services.ts. Everything works without any of these (mock mode).
# EXPO_PUBLIC_* values are bundled into the app (public). Never put server secrets in them.
# After editing .env restart Metro: npx expo start -c

# --- App identity overrides (optional, defaults live in app.identity.js) ---
# Display name under the app icon
APP_NAME=
# URL-safe project slug used by Expo/EAS
APP_SLUG=
# Deep link scheme (myapp://)
APP_SCHEME=
# iOS bundle identifier, e.g. com.yourname.yourapp
APP_IOS_BUNDLE_ID=
# Android package name, e.g. com.yourname.yourapp
APP_ANDROID_PACKAGE=
# EAS project id (set by `eas init`, or paste it here)
EAS_PROJECT_ID=

# --- Supabase (auth + ai) ---
# Project URL from Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
# Public anon / publishable key from the same page (safe in the app, protected by RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Name of the AI edge function (default: ai)
EXPO_PUBLIC_AI_FUNCTION_NAME=

# --- RevenueCat (purchases, needs a development build) ---
# Public Apple App Store SDK key from RevenueCat -> API keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Public Google Play SDK key from RevenueCat -> API keys
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Entitlement identifier that means "pro" (default: pro)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=

# --- Sentry (monitoring) ---
# Client DSN from Sentry -> Project Settings -> Client Keys
EXPO_PUBLIC_SENTRY_DSN=
# Sentry org slug, only for source map upload in EAS builds
SENTRY_ORG=
# Sentry project slug, only for source map upload in EAS builds
SENTRY_PROJECT=
# Sentry auth token for source map upload (EAS secret, never EXPO_PUBLIC_)
SENTRY_AUTH_TOKEN=

# --- Amplitude (analytics) ---
# Project API key from Amplitude -> Settings -> Projects
EXPO_PUBLIC_AMPLITUDE_API_KEY=

# --- Server secrets: set with `supabase secrets set NAME=value`, NOT in the app ---
# Google AI Studio key used by supabase/functions/ai
GEMINI_API_KEY=
# Gemini model id for supabase/functions/ai (default: gemini-3.6-flash)
GEMINI_MODEL=
# Shared secret RevenueCat sends in the webhook Authorization header
REVENUECAT_WEBHOOK_SECRET=
# Entitlement id the webhook maps to profiles.is_pro (default: pro)
REVENUECAT_ENTITLEMENT=
